; ---- the screen ----

node brick_shape (c)
  says "the rectangle of an intact brick in its row colour, or nothing for a removed one"
  fx none
  raises BadCell
  post (in out.k ["rect" "none"])
  out (if c.alive {k "rect" x (- (brick_cx c) HALF_BW) y (- (brick_cy c) HALF_BH) w BRICK_W h BRICK_H c (cat "row" (str c.a))} {k "none"})
  ex {c {a 0 b 0 alive true}} -> {k "rect" x 150 y 6000 w 4200 h 1600 c "row0"}
  ex {c {a 0 b 0 alive false}} -> {k "none"}
  ex {c {a 9 b 0 alive true}} refuse BadCell

node burst_shape (u)
  says "a ring that grows and fades over a burst's life"
  fx none
  pre (== (burst_ok u) 1) BadBurst
  post (== out.k "ring")
  out {k "ring" x u.x y u.y r (+ R (* u.age HUD_X)) age u.age}
  ex {u {x 2250 y 6800 age 2}} -> {k "ring" x 2250 y 6800 r 3000 age 2}
  ex {u {x 2250 y 6800 age 9}} refuse BadBurst

node overlay (state)
  says "the words over the field for the phase: title, serve, paused, won, lost; nothing during play"
  fx none
  pre (state_ok state) BadState
  post (<= (len out) 3)
  let ph state.phase
  out (if (== ph "title") [{k "text" x CENTER_X y TITLE_Y t "BREAKOUT" s "big"} {k "text" x CENTER_X y (+ TITLE_Y LINE) t "Move: ← → or drag · Launch: space or tap" s "small"} {k "text" x CENTER_X y (+ TITLE_Y TWO_LINES) t "P pauses · R restarts" s "small"}] (if (== ph "serve") [{k "text" x CENTER_X y CENTER_Y t (cat (str state.lives) (if (== state.lives 1) " life left" " lives left")) s "big"} {k "text" x CENTER_X y (+ CENTER_Y LINE) t "Space or tap to launch" s "small"}] (if (== ph "paused") [{k "text" x CENTER_X y CENTER_Y t "PAUSED" s "big"} {k "text" x CENTER_X y (+ CENTER_Y LINE) t "Space or tap to resume" s "small"}] (if (== ph "won") [{k "text" x CENTER_X y CENTER_Y t "YOU WIN" s "big"} {k "text" x CENTER_X y (+ CENTER_Y LINE) t "All 30 bricks cleared · R or tap to play again" s "small"}] (if (== ph "lost") [{k "text" x CENTER_X y CENTER_Y t "GAME OVER" s "big"} {k "text" x CENTER_X y (+ CENTER_Y LINE) t (cat (cat "Score " (str state.score)) " · R or tap to play again") s "small"}] [])))))
  ex {state {phase "title" resume_to "play" paddle {x 13000} ball {x 16000 y 43400 vx -200 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 3 launches 0 ticks 0 last "none" bursts []}} check (== (len out) 3)
  ex {state {phase "play" resume_to "play" paddle {x 13000} ball {x 16000 y 30000 vx 100 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 3 launches 1 ticks 10 last "none" bursts []}} check (== (len out) 0)
  ex {state {phase "serve" resume_to "play" paddle {x 13000} ball {x 16000 y 43400 vx -200 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 2 launches 1 ticks 10 last "none" bursts []}} check (== (len out) 2)
  ex {state {phase "play" resume_to "play" paddle {x 13000} ball {x 16000 y 30000 vx 100 vy -450} bricks [] score 0 lives 3 launches 1 ticks 10 last "none" bursts []}} refuse BadState

node view (state)
  says "the draw list: field, bricks, bursts, paddle, ball, score and lives, and the phase overlay"
  fx none
  pre (state_ok state) BadState
  post (> (len out) BRICKS)
  let field [{k "rect" x 0 y 0 w W h H c "field"}]
  let bricks (map "brick_shape" state.bricks)
  let bursts (map "burst_shape" state.bursts)
  let actors [{k "rect" x state.paddle.x y PADDLE_Y w PADDLE_W h PADDLE_H c "paddle"} {k "circle" x state.ball.x y state.ball.y r R c "ball"}]
  let hud [{k "text" x HUD_X y HUD_Y t (cat "SCORE " (str state.score)) s "hud" align "left"} {k "text" x LIVES_X y HUD_Y t (cat "LIVES " (str state.lives)) s "hud" align "right"}]
  out (concat (concat field bricks) (concat (concat bursts actors) (concat hud (overlay state))))
  ex {state {phase "play" resume_to "play" paddle {x 13000} ball {x 16000 y 30000 vx 100 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 3 launches 1 ticks 10 last "none" bursts []}} check (== (len out) 35)
  ex {state {phase "title" resume_to "play" paddle {x 13000} ball {x 16000 y 43400 vx -200 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 3 launches 0 ticks 0 last "none" bursts []}} check (== (len out) 38)
  ex {state {phase "play" resume_to "play" paddle {x 13000} ball {x 16000 y 30000 vx 100 vy -450} bricks [] score 0 lives 3 launches 1 ticks 10 last "none" bursts []}} refuse BadState

node sound_of (last)
  says "the sound for what just happened, or none"
  fx none
  post (in out ["none" "wall" "paddle" "brick" "lost" "win" "launch"])
  out (if (in last ["wall" "paddle" "brick" "lost" "win" "launch"]) last "none")
  ex {last "brick"} -> "brick"
  ex {last "none"} -> "none"
  ex {last "other"} -> "none"

node frame (state event)
  says "the entry point: one event in, the next state out, the field drawn and the sound played; on a refusal nothing is drawn and the host keeps the old state"
  fx Screen Audio
  inv G1 G2 G3 G4 G5
  raises BadState WrongPhase BadIntent BadEvent
  post (state_ok out)
  let s (step state event)
  let drawn (screen.draw (view s))
  let played (audio.play (sound_of s.last))
  out s
  ex {state {phase "play" resume_to "play" paddle {x 13000} ball {x 16000 y 30000 vx 100 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 3 launches 1 ticks 10 last "none" bursts []} event {kind "tick" move 1 target -1}} check (== out.ticks 11) (== out.paddle.x 13600)
  ex {state {phase "title" resume_to "play" paddle {x 13000} ball {x 16000 y 43400 vx -200 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 3 launches 0 ticks 0 last "none" bursts []} event {kind "launch"}} check (== out.phase "play")
