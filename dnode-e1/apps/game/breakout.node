  ex {state {phase "play" resume_to "play" paddle {x 13000} ball {x 16000 y 30000 vx 100 vy -450} bricks [] score 0 lives 3 launches 1 ticks 10 last "none" bursts []}} refuse BadState

node on_pause (state)
  says "pause freezes play or serve exactly where it is"
  fx none
  inv G1 G2 G3 G4 G5
  pre (state_ok state) BadState
  pre (in state.phase ["play" "serve"]) WrongPhase
  post (state_ok out)
  post (== out.phase "paused")
