node on_launch (state)
  says "the player launches: from the title or from the paddle the ball leaves upward; counted, so the next serve angle differs"
  fx none
  inv G1 G2 G3 G4 G5
  pre (state_ok state) BadState
  pre (in state.phase ["title" "serve"]) WrongPhase
  post (state_ok out)
  post (== out.phase "play")
  post (== out.launches (+ state.launches 1))
  out (with state phase "play" resume_to "play" ball (on_paddle state.paddle state.launches) launches (+ state.launches 1) last "launch")
  ex {state {phase "title" resume_to "play" paddle {x 13000} ball {x 16000 y 43400 vx -200 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 3 launches 0 ticks 0 last "none" bursts []}} check (== out.phase "play") (== out.launches 1) (== out.ball.vy -450)
  ex {state {phase "serve" resume_to "play" paddle {x 13000} ball {x 16000 y 43400 vx -200 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 2 launches 1 ticks 10 last "none" bursts []}} check (== out.phase "play") (== out.launches 2)
