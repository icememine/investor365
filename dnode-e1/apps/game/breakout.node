node on_resume (state)
  says "resume continues from the frozen state; no time passed for the game"
  fx none
  inv G1 G2 G3 G4 G5
  pre (state_ok state) BadState
  pre (== state.phase "paused") WrongPhase
  post (state_ok out)
  post (== out.phase state.resume_to)
  post (== out.ball state.ball)
  out (with state phase state.resume_to last "none")
  ex {state {phase "paused" resume_to "play" paddle {x 13000} ball {x 16000 y 30000 vx 100 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 3 launches 1 ticks 10 last "none" bursts []}} check (== out.phase "play") (== out.ticks 10)
