  seq state {phase "play" resume_to "play" paddle {x 13000} ball {x 16000 y 43400 vx -200 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 3 launches 1 ticks 10 last "none" bursts []} over [{event {kind "tick" move 0 target -1}} {event {kind "tick" move -1 target -1}} {event {kind "tick" move -1 target -1}} {event {kind "pause"}} {event {kind "tick" move 1 target -1}} {event {kind "resume"}} {event {kind "tick" move 1 target -1}} {event {kind "tick" move 0 target 20000}}] check (== out.phase "play") (== out.lives 3) (== out.ticks 15)
