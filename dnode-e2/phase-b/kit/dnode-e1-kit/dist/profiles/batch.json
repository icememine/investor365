{
  "id": "batch-e1",
  "version": "201020261730-E1",
  "checking": "strict",
  "maxOperations": 10000000,
  "natives": [
    "!=",
    "*",
    "+",
    "-",
    "<",
    "<=",
    "==",
    ">",
    ">=",
    "abs",
    "all",
    "and",
    "any",
    "at",
    "cat",
    "concat",
    "contains",
    "csv",
    "decimal",
    "div",
    "duplicates",
    "emit",
    "encode",
    "len",
    "matches",
    "max",
    "min",
    "mod",
    "nat_fits",
    "neg",
    "not",
    "or",
    "range",
    "slice",
    "sort_by",
    "str",
    "sum",
    "unique"
  ],
  "grants": [],
  "capabilities": {},
  "host": {
    "maxBytes": 1048576,
    "maxRows": 10000,
    "encoding": "UTF-8 fatal decoder, optional initial BOM",
    "publication": "whole Blob download in browser; temp-file then rename in CLI"
  }
}
