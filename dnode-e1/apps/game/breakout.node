node on_restart (state)
  says "restart: exactly the initial state, whatever came before"
  fx none
  post (state_ok out)
  post (== out (initial))
  let seen state.ticks
  out (if (>= seen 0) (initial) (initial))
  ex {state {phase "lost" resume_to "play" paddle {x 13000} ball {x 16000 y 30000 vx 100 vy -450} bricks [{a 0 b 0 alive true} {a 0 b 1 alive true} {a 0 b 2 alive true} {a 0 b 3 alive true} {a 0 b 4 alive true} {a 0 b 5 alive true} {a 1 b 0 alive true} {a 1 b 1 alive true} {a 1 b 2 alive true} {a 1 b 3 alive true} {a 1 b 4 alive true} {a 1 b 5 alive true} {a 2 b 0 alive true} {a 2 b 1 alive true} {a 2 b 2 alive true} {a 2 b 3 alive true} {a 2 b 4 alive true} {a 2 b 5 alive true} {a 3 b 0 alive true} {a 3 b 1 alive true} {a 3 b 2 alive true} {a 3 b 3 alive true} {a 3 b 4 alive true} {a 3 b 5 alive true} {a 4 b 0 alive true} {a 4 b 1 alive true} {a 4 b 2 alive true} {a 4 b 3 alive true} {a 4 b 4 alive true} {a 4 b 5 alive true}] score 0 lives 0 launches 1 ticks 10 last "lost" bursts []}} check (== out.phase "title") (== out.lives 3) (== out.score 0) (== out.ticks 0)
  ex {state {phase "won" resume_to "play" paddle {x 13000} ball {x 16000 y 30000 vx 100 vy -450} bricks [{a 0 b 0 alive false} {a 0 b 1 alive false} {a 0 b 2 alive false} {a 0 b 3 alive false} {a 0 b 4 alive false} {a 0 b 5 alive false} {a 1 b 0 alive false} {a 1 b 1 alive false} {a 1 b 2 alive false} {a 1 b 3 alive false} {a 1 b 4 alive false} {a 1 b 5 alive false} {a 2 b 0 alive false} {a 2 b 1 alive false} {a 2 b 2 alive false} {a 2 b 3 alive false} {a 2 b 4 alive false} {a 2 b 5 alive false} {a 3 b 0 alive false} {a 3 b 1 alive false} {a 3 b 2 alive false} {a 3 b 3 alive false} {a 3 b 4 alive false} {a 3 b 5 alive false} {a 4 b 0 alive false} {a 4 b 1 alive false} {a 4 b 2 alive false} {a 4 b 3 alive false} {a 4 b 4 alive false} {a 4 b 5 alive false}] score 30 lives 3 launches 1 ticks 10 last "win" bursts []}} check (== out (initial))

node event_ok (event)
  says "true when an event carries the fields its kind needs"
  fx none
  post (in out [true false])
  out (if (== event.kind "tick") (and (has event "move") (has event "target")) (in event.kind ["launch" "pause" "resume" "restart" "noop"]))
  ex {event {kind "tick" move 0 target -1}} -> true
  ex {event {kind "tick" move 0}} -> false
  ex {event {kind "launch"}} -> true
  ex {event {kind "fly"}} -> false

node step (state event)
  says "one event applied to the game"
  fx none
  inv G1 G2 G3 G4 G5
  raises WrongPhase BadIntent
  pre (state_ok state) BadState
  pre (event_ok event) BadEvent
  post (state_ok out)
  let k event.kind
  out (if (== k "tick") (on_tick state event.move event.target) (if (== k "launch") (on_launch state) (if (== k "pause") (on_pause state) (if (== k "resume") (on_resume state) (if (== k "restart") (on_restart state) (with state last "none"))))))
